# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Environment / secrets
.env
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Packaging / tooling
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ReconPipe generated artifacts (regenerated on every run)
*.duckdb
*.duckdb.wal
data/staging/*
data/quarantine/*
reports/*
!**/.gitkeep

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
logs/

# Legacy GL engine sample inputs (regenerated by generate_sample_data.py)
data/gl_raw/
data/processed/
output/
# files dropped in for `reconpipe process inbox` (may be confidential)
inbox/*
!inbox/.gitkeep
# column mappings remembered by `reconpipe ai map-columns` / --ai (yours to commit or not)
# config/column_memory.json

# Dagster local instance (dagster dev without DAGSTER_HOME)
.tmp_dagster_home*/
